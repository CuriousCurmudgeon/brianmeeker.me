---
import VenueBadge from "./VenueBadge.astro";
import { buildTalkUrl } from "../utilities/urlBuilder";

const { talk } = Astro.props;
const { title, summary, appearances } = talk.data;
const url = buildTalkUrl(talk);
---

<article
  class="flex flex-col h-full border-2 border-slate-400 bg-slate-50 hover:border-slate-800 p-6 transition-all"
>
  <h2 class="text-xl font-bold leading-tight">
    <a href={url}>{title}</a>
  </h2>

  <p class="mt-3 text-sm leading-6 line-clamp-4">{summary}</p>

  {
    appearances.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {appearances.map((appearance: any) => (
          <li>
            <VenueBadge venue={appearance.venue} url={appearance.url} />
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto pt-6">
    <a href={url} class="uppercase text-sm font-bold">
      Details
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5 inline"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
      </svg>
    </a>
  </div>
</article>
