---
import '../styles/global.css';
import NavLink from "../components/NavLink.astro";
import SocialLinks from "../components/SocialLinks.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;

// Evaluated at build time, so this advances whenever the site is deployed.
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Yet Another Software Engineer's Blog" />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen w-screen flex flex-col bg-white font-mono text-white overflow-x-hidden"
  >
    <nav
      class="p-4 sm:py-6 sm:px-12 flex flex-wrap items-center gap-y-2 bg-green-900 sm:text-xl"
    >
      <NavLink href="/">brianmeeker.me</NavLink>
      <!-- flex-auto rather than flex-1 so the group wraps on its content
           width instead of collapsing to a zero basis and overflowing. -->
      <div class="flex flex-auto gap-2 md:gap-6 justify-end items-center">
        <NavLink href="/speaking">Speaking</NavLink>
        <NavLink href="/contact">Contact</NavLink>
        <NavLink href="/about">About</NavLink>
        <SocialLinks />
      </div>
    </nav>

    <main class="flex flex-1 text-black">
      <slot />
    </main>

    <footer
      class="p-4 sm:py-6 sm:px-12 flex flex-col items-center gap-3 bg-green-900 text-xs"
    >
      <SocialLinks />
      <div>© {currentYear} Brian Meeker</div>
    </footer>

    <!-- 100% privacy friendly analytics -->
    <script is:inline async defer src="https://sa.brianmeeker.me/latest.js"></script>
    <noscript
      ><img
        src="https://sa.brianmeeker.me/noscript.gif"
        alt=""
        referrerpolicy="no-referrer-when-downgrade"
      />
    </noscript>
  </body>
</html>
